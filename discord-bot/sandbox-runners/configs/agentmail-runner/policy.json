{
  "allowedSkills": ["agentmail"],
  "actions": {
    "agentmail": {
      "send": {
        "enabled": true,
        "requireTo": true,
        "allowedRecipientDomains": ["thesocial.study"],
        "requiredFields": ["to", "subject", "templateId"],
        "allowedTemplateIds": ["brief-v1", "alert-v1"],
        "maxSubjectLength": 120,
        "maxBodyLength": 4000,
        "maxPayloadKeys": 12
      }
    }
  },
  "network": {
    "egressMode": "allowlist",
    "notes": "Enforce with host firewall/proxy."
  }
}

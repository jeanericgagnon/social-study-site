      </a>

      <a
        href="https://www.tiktok.com/@thesocial.study"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="TikTok"
        class="w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center bg-[#2a5d67] rounded-full border-2 border-black hover:bg-[#1d4249] transition-colors duration-300"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16.6 5.82C15.9165 5.03962 15.5397 4.03743 15.54 3H12.45V15.4C12.4262 16.071 12.1429 16.7066 11.6598 17.1729C11.1767 17.6393 10.5314 17.8999 9.86003 17.9C8.44003 17.9 7.26003 16.74 7.26003 15.3C7.26003 13.58 8.92003 12.29 10.63 12.87V9.72C7.18003 9.17 4.11003 11.81 4.11003 15.3C4.11003 18.57 6.82003 21 9.85003 21C13.15 21 15.84 18.31 15.84 15V9.25C16.9449 10.0498 18.2351 10.4775 19.5601 10.49V7.4C19.5601 7.4 17.77 7.5 16.6 5.82Z" fill="white"/>
        </svg>
      </a>

      <a
        href="https://www.linkedin.com/company/thesocialstudy/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center bg-[#d7795d] rounded-full border-2 border-black hover:bg-[#c25d41] transition-colors duration-300"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M4.98 3.5C4.98 4.88 3.87 6 2.49 6C1.12 6 0 4.88 0 3.5C0 2.12 1.12 1 2.49 1C3.87 1 4.98 2.12 4.98 3.5ZM0.5 23.5H4.5V7.5H0.5V23.5ZM8.5 7.5H12.3V9.7H12.35C12.88 8.7 14.17 7.6 16.1 7.6C20.2 7.6 21 10.3 21 13.8V23.5H17V14.9C17 12.9 17 10.8 14.7 10.8C12.3 10.8 12 12.7 12 14.8V23.5H8V7.5H8.5Z" fill="white"/>
        </svg>
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    const nav = document.getElementById('landingNav');
    const logo = document.getElementById('landingNavLogo');
    if (!nav || !logo) return;

    function update() {
      const isMobile = window.innerWidth < 640;
      const globePosition = 700;
      const showBg = isMobile ? window.scrollY > 50 : window.scrollY > globePosition;

      nav.classList.toggle('bg-[#f6f0d5]', showBg);
      nav.classList.toggle('bg-transparent', !showBg);

      logo.classList.toggle('opacity-100', showBg);
      logo.classList.toggle('opacity-0', !showBg);
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

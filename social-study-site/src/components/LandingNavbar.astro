---
const globeSrc = 'globe-1.png';
---

<nav id="landingNav" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-transparent">
  <div class="max-w-[1248px] mx-auto px-4 h-20 sm:h-28 flex items-center justify-between">
    <a href="#top" aria-label="Back to top">
      <img
        id="landingNavLogo"
        class="w-16 h-16 sm:w-24 sm:h-24 object-contain transition-all duration-300 hover:scale-110 opacity-0 cursor-pointer"
        alt="The Social Study Globe Logo"
        loading="eager"
        src={globeSrc}
      />
    </a>

    <div class="flex items-center space-x-4">
      <a
        href="https://www.instagram.com/thesocial.study/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center bg-[#d7795d] rounded-full border-2 border-black hover:bg-[#c25d41] transition-colors duration-300"
      >

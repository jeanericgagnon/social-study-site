<script is:inline>
  (function () {
    function openModal(id) {
      var d = document.getElementById(id);
      if (!d) return;
      if (typeof d.showModal === 'function') d.showModal();
      else d.setAttribute('open', '');
    }
    function closeModal(dialogEl) {
      if (!dialogEl) return;
      if (typeof dialogEl.close === 'function') dialogEl.close();
      else dialogEl.removeAttribute('open');
    }

    function setPanel(rootEl, panelId) {
      if (!rootEl || !panelId) return;
      var panels = rootEl.querySelectorAll('[data-panel]');
      panels.forEach(function (p) {
        p.classList.toggle('hidden', p.getAttribute('data-panel') !== panelId);
      });
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!(t instanceof Element)) return;

      var openBtn = t.closest('[data-modal-open]');
      if (openBtn) {
        e.preventDefault();
        var id = openBtn.getAttribute('data-modal-open');
        if (id) openModal(id);
        return;
      }

      var panelBtn = t.closest('[data-panel-open]');
      if (panelBtn) {
        e.preventDefault();
        var dlg = panelBtn.closest('dialog');
        var panelId = panelBtn.getAttribute('data-panel-open');
        if (dlg && panelId) setPanel(dlg, panelId);
        return;
      }

      // Close button
      var closeBtn = t.closest('[data-modal-close]');
      if (closeBtn) {
        var dlg = closeBtn.closest('dialog');
        closeModal(dlg);
        return;
      }

      // Click outside content closes
      if (t instanceof HTMLDialogElement) {
        closeModal(t);
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var open = document.querySelector('dialog[open]');
      if (open) closeModal(open);
    });

    // Default all dialogs to their menu panel on open
    document.addEventListener('close', function (e) {
      var dlg = e.target;
      if (!(dlg instanceof HTMLDialogElement)) return;
      setPanel(dlg, 'menu');
    }, true);
    document.addEventListener('cancel', function (e) {
      var dlg = e.target;
      if (!(dlg instanceof HTMLDialogElement)) return;
      setPanel(dlg, 'menu');
    }, true);
  })();
</script>

---
import MailchimpSignup from './MailchimpSignup.astro';
---

<div data-panel="menu">
  <p class="text-slate-900/90">Select your city:</p>
  <div class="mt-4 flex flex-wrap justify-center gap-3">
    <button class="rounded-full border-2 border-black bg-[var(--teal)] px-6 py-3 font-semibold text-white hover:opacity-90" data-panel-open="sd">San Diego</button>
    <button class="rounded-full border-2 border-black bg-[var(--coral)] px-6 py-3 font-semibold text-white hover:opacity-90" data-panel-open="oc">Orange County</button>
    <button class="rounded-full border-2 border-black bg-[var(--espresso)] px-6 py-3 font-semibold text-white hover:opacity-90" data-panel-open="den">Denver</button>
  </div>
</div>

<div class="hidden" data-panel="sd">
  <button class="text-sm underline" data-panel-open="menu">← Back</button>
  <div class="mt-4">
    <MailchimpSignup title="San Diego" subtitle="Ticket drops + updates" f_id="006de6e3f0" tags="1853334,1853469" />
  </div>
</div>

<div class="hidden" data-panel="oc">
  <button class="text-sm underline" data-panel-open="menu">← Back</button>
  <div class="mt-4">
    <MailchimpSignup title="Orange County" subtitle="Ticket drops + updates" f_id="001ae6e3f0" tags="1853487" />
  </div>
</div>

<div class="hidden" data-panel="den">
  <button class="text-sm underline" data-panel-open="menu">← Back</button>
  <div class="mt-4">
    <MailchimpSignup title="Denver" subtitle="Ticket drops + updates" f_id="0034e6e3f0" tags="1853740" />
  </div>
</div>

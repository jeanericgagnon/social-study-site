---
const isHome = Astro.url.pathname === '/';
const p = isHome ? '' : '../';

const nav = [
  { href: `${p}#cities`, label: 'Cities' },
  { href: `${p}events/`, label: 'Events' },
  { href: `${p}newsletter/`, label: 'Newsletter' },
  { href: `${p}speak/`, label: 'Speak' },
  { href: `${p}host/`, label: 'Host' },
];
---

<header class="mx-auto max-w-6xl px-4 py-5">
  <div class="flex items-center justify-between gap-4">
    <a href={`${p}`} class="flex items-center gap-3">
      <img src={`${p}brand/Globe.png`} alt="The Social Study" class="h-9 w-9" />
      <span class="text-2xl leading-none" style="font-family: 'Baloo 2', system-ui;">The Social Study</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-[15px]">
      {nav.map((item) => (
        <a class="hover:underline" href={item.href}>{item.label}</a>
      ))}
      <a
        href="https://eventship.com/host/the-social-study"
        class="rounded-full bg-slate-900 px-4 py-2 text-white hover:bg-slate-800"
        rel="noopener"
      >
        Get tickets
      </a>
    </nav>
  </div>
</header>

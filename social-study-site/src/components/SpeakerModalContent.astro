---
import HubSpotForm from './HubSpotForm.astro';
const portalId = '49143429';
---

<div data-panel="menu">
  <p class="text-slate-900/90">Short, sharp, story-forward talks that work in a bar setting.</p>
  <p class="mt-2 text-slate-900/90">Select your city:</p>
  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    <button class="rounded-full border-2 border-black bg-white px-5 py-3 hover:bg-slate-50" data-panel-open="sd">San Diego</button>
    <button class="rounded-full border-2 border-black bg-white px-5 py-3 hover:bg-slate-50" data-panel-open="oc">Orange County</button>
    <button class="rounded-full border-2 border-black bg-white px-5 py-3 hover:bg-slate-50" data-panel-open="den">Denver</button>
  </div>
</div>

<div class="hidden" data-panel="sd">
  <button class="text-sm underline" data-panel-open="menu">← Back</button>
  <div class="mt-4"><HubSpotForm portalId={portalId} formId="cd909a62-610c-44e3-9759-460913af5652" region="na1" /></div>
</div>

<div class="hidden" data-panel="oc">
  <button class="text-sm underline" data-panel-open="menu">← Back</button>
  <div class="mt-4"><HubSpotForm portalId={portalId} formId="ae0e15d7-e7f1-4610-82c7-a584c99e0419" region="na1" /></div>
</div>

<div class="hidden" data-panel="den">
  <button class="text-sm underline" data-panel-open="menu">← Back</button>
  <div class="mt-4"><HubSpotForm portalId={portalId} formId="1c1c9692-139b-42e1-87d5-2f0adbf5fdbc" region="na1" /></div>
</div>

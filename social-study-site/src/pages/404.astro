---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const title = 'Page not found | The Social Study';
const description = 'Sorry—this page does not exist.';
---

<BaseLayout title={title} description={description} robots="noindex,follow">
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-4 pb-20">
    <header class="mt-10 rounded-[26px] border-[3px] border-black bg-[var(--cream)] p-6">
      <h1 class="h-brand text-5xl">Page not found</h1>
      <p class="mt-3 text-slate-700">That link doesn’t exist. Try the homepage.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="rounded-full border-[3px] border-black bg-[var(--gold)] px-6 py-3 font-semibold text-[#592d10] hover:opacity-90" href="/">Home</a>
        <a class="rounded-full border-[3px] border-black bg-white px-6 py-3 font-semibold hover:bg-slate-50" href="/newsletter/">Newsletter</a>
        <a class="rounded-full border-[3px] border-black bg-white px-6 py-3 font-semibold hover:bg-slate-50" href="/events/">Events</a>
      </div>
    </header>
  </main>
</BaseLayout>

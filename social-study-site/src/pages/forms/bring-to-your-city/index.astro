---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import HubSpotForm from '../../../components/HubSpotForm.astro';
import '../../../styles/global.css';

const title = 'Bring The Social Study to Your City | Form';
const description = 'Tell us where you want The Social Study next.';
---

<BaseLayout title={title} description={description} robots="noindex,follow">
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-4 pb-20">
    <header class="mt-6 rounded-[26px] border-[3px] border-black bg-[var(--cream)] p-6">
      <h1 class="h-brand text-5xl">Bring it to your city</h1>
      <p class="mt-3 text-slate-700">Tell us where you want Social Study next.</p>
    </header>

    <div class="mt-8">
      <HubSpotForm portalId="49143429" formId="2f792adc-cf3e-4361-8889-b5c5913463e7" region="na1" />
    </div>
  </main>
</BaseLayout>

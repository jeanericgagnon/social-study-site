---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import '../../styles/global.css';

const title = 'Forms | The Social Study';
const description = 'Signup and application forms for The Social Study.';
---

<BaseLayout title={title} description={description} robots="noindex,follow">
  <SiteHeader />
  <main class="mx-auto max-w-4xl px-4 pb-20">
    <header class="mt-6 rounded-[26px] border-[3px] border-black bg-[var(--cream)] p-6">
      <h1 class="h-brand text-5xl">Forms</h1>
      <p class="mt-3 text-slate-700">Direct links to signups and applications.</p>
    </header>

    <section class="mt-10 grid gap-4">
      <a class="rounded-[26px] border-[3px] border-black bg-white p-5 hover:bg-slate-50" href="./newsletter/">Newsletter signup</a>
      <a class="rounded-[26px] border-[3px] border-black bg-white p-5 hover:bg-slate-50" href="./speaker/">Become a speaker</a>
      <a class="rounded-[26px] border-[3px] border-black bg-white p-5 hover:bg-slate-50" href="./host/">Host an event</a>
      <a class="rounded-[26px] border-[3px] border-black bg-white p-5 hover:bg-slate-50" href="./bring-to-your-city/">Bring to your city</a>
      <a class="rounded-[26px] border-[3px] border-black bg-white p-5 hover:bg-slate-50" href="./mc-denver/">MC Denver</a>
    </section>

    <footer class="mt-16 border-t border-slate-200 pt-8 text-sm text-slate-600">
      <a class="underline" href="../privacy/">Privacy</a>
    </footer>
  </main>
</BaseLayout>

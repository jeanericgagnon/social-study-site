---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import HubSpotForm from '../../../components/HubSpotForm.astro';
import '../../../styles/global.css';

const title = 'Become a Speaker — Orange County | The Social Study';
const description = 'Speaker application for The Social Study (Orange County).';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-4 pb-20">
    <header class="mt-6 rounded-[26px] border-[3px] border-black bg-[var(--cream)] p-6">
      <div class="text-xs uppercase tracking-widest text-slate-600">Become a speaker</div>
      <h1 class="h-brand mt-2 text-5xl">Orange County</h1>
      <p class="mt-3 text-slate-700">Apply to speak at The Social Study.</p>
    </header>

    <div class="mt-8">
      <HubSpotForm portalId="49143429" formId="ae0e15d7-e7f1-4610-82c7-a584c99e0419" region="na1" />
    </div>

    <div class="mt-6 text-center">
      <a class="underline" href="../">Choose a different city</a>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/LandingNavbar.astro';
import Modal from '../components/Modal.astro';
import ModalScript from '../components/ModalScript.astro';
import NewsletterModalContent from '../components/NewsletterModalContent.astro';
import SpeakerModalContent from '../components/SpeakerModalContent.astro';
import HostModalContent from '../components/HostModalContent.astro';
import BringCityModalContent from '../components/BringCityModalContent.astro';
import McDenverModalContent from '../components/McDenverModalContent.astro';
import '../styles/global.css';

const title = 'The Social Study | Lectures in Bars and Breweries';
const description = 'Join intimate 60-minute lectures by professors, experts, and storytellers in bars and breweries across San Diego, Orange County, and Denver. Educational talks over drinks in a casual setting.';

const actionCards = [
  {
    title: 'JOIN NEWSLETTER',
    bg: '#2a5d67',
    hover: '#1d4249',
    img: 'newsletterbackgroundremoved-1.png',
    modal: 'modal-newsletter',
    fallbackHref: 'newsletter/',
    mobile: { w: 280, h: 280, top: -40 },
  },
  {
    title: 'BECOME A SPEAKER',
    bg: '#d7795d',
    hover: '#c25d41',
    img: 'speakerbackgroundremoved-1.png',
    modal: 'modal-speaker',
    fallbackHref: 'speak/',
    // Speaker art is taller; push it down a bit so it doesn't look like it's floating.
    mobile: { w: 300, h: 300, top: -18 },
  },
  {
    title: 'HOST AN EVENT',
    bg: '#C89F56',
    hover: '#b18c49',
    img: 'projector.png',
    modal: 'modal-host',
    fallbackHref: 'host/',
    mobile: { w: 250, h: 250, top: -10 },
  },
  {
    title: 'BRING TO YOUR CITY',
    bg: '#3b2f2f',
    hover: '#2a2222',
    img: 'bringyourcity-1.png',
    modal: 'modal-city',
    fallbackHref: 'bring-to-your-city/',
    // This icon was getting clipped; shrink + lower.
    mobile: { w: 240, h: 240, top: 0 },
  },
];

const faqs = [
  {
    q: 'What is The Social Study?',
    a: 'Talks from professors, experts, and great storytellers—hosted in bars. Slides encouraged. No homework. Just interesting ideas in a casual setting.',
  },
  {
    q: 'How do I buy tickets?',
    a: 'We send out a newsletter when tickets go on sale. To avoid missing out, sign up above. We also post on Instagram. Each event is intimate and space is limited.',
  },
  {
    q: 'What happens at a Social Study event?',
    a: 'One speaker. A 60-minute talk, followed by ~20 minutes of Q&A. A good crowd. A drink or two. Time to hang out.',
  },
  {
    q: 'Where are the events?',
    a: 'Bars and breweries in various cities. We move around.',
  },
  {
    q: "What if I don't drink?",
    a: 'No pressure. Most places have non-alcoholic options.',
  },
  {
    q: 'Can I speak at one?',
    a: "Yes. If you've got something to share and you're a strong storyteller, apply on the Speak page.",
  },
  {
    q: 'Do I need a ticket?',
    a: 'Yep. All events are ticketed and space is limited.',
  },
];
---

<BaseLayout title={title} description={description}>
  <a id="top"></a>
  <LandingNavbar />

  <main class="bg-[#f6f0d5] flex flex-row justify-center w-full">
    <Modal id="modal-newsletter" title="Join the newsletter" wide>
      <NewsletterModalContent />
    </Modal>
    <Modal id="modal-speaker" title="Become a speaker" wide>
      <SpeakerModalContent />
    </Modal>
    <Modal id="modal-host" title="Host an event" wide>
      <HostModalContent />
    </Modal>
    <Modal id="modal-city" title="Bring it to your city">
      <BringCityModalContent />
    </Modal>
    <Modal id="modal-mc" title="MC Denver">
      <McDenverModalContent />
    </Modal>
    <ModalScript />

    <div class="bg-[#f6f0d5] w-full max-w-[1248px] relative overflow-x-hidden">
      <div class="relative w-full max-w-[1001px] mx-auto px-4 sm:px-9">
        <!-- Hero -->
        <header class="relative w-full h-[600px] sm:h-[784px]">
          <div class="relative w-full h-full flex flex-col items-center">
            <div class="relative w-full flex justify-center">
              <img
                class="w-[300px] h-[300px] sm:w-[524px] sm:h-[524px] object-contain mt-[18px]"
                alt="The Social Study Logo"
                src="cloudsocial-1.png"
                loading="eager"
              />
            </div>

            <img
              class="absolute w-[236px] h-[236px] sm:w-[428px] sm:h-[428px] top-[167px] sm:top-[247px] right-[-40px] sm:right-[50px] object-contain z-10"
              alt="Globe"
              src="globe-1.png"
              loading="lazy"
            />

            <div
              class="absolute w-[calc(100%-2rem)] sm:w-[556px] top-[273px] sm:top-[457px] px-0 sm:px-0 sm:left-[80px] h-hand font-normal text-black text-[40px] sm:text-[44px] tracking-[-0.84px] leading-[1.2] text-left mb-16 sm:mb-32 sm:whitespace-normal"
            >
              <span class="sm:hidden leading-[1.1] relative z-30">
                60-minute<br />
                lectures by professors,<br />
                experts, and storytellers in<br />
                bars and breweries
              </span>
              <span class="hidden sm:inline leading-[1.1] relative z-30">
                60-minute<br />
                lectures by professors,<br />
                experts, and storytellers in<br />
                bars and breweries
              </span>
            </div>

            <img
              class="absolute w-[300px] h-[300px] sm:w-[524px] sm:h-[524px] top-[18px] left-[50%] -translate-x-1/2 object-cover pointer-events-none z-20"
              alt="Y"
              src="y-1.png"
              loading="lazy"
            />
          </div>
        </header>

        <!-- Buy Tickets -->
        <section class="flex justify-center mt-2 sm:-mt-16">
          <a
            class="flex flex-col w-full max-w-[600px] mx-4 sm:mx-0 border-none shadow-none cursor-pointer transform transition-all duration-300 hover:scale-[1.02]"
            href="https://eventship.com/host/the-social-study"
            target="_blank"
            rel="noopener"
          >
            <div class="relative w-full h-[120px] sm:h-[160px] border-[3px] border-solid border-black rounded-[26px] bg-[#e6b74b]">
              <img
                class="absolute w-[100px] h-[100px] sm:w-[150px] sm:h-[150px] top-[5px] left-[10px] sm:left-[30px] object-cover"
                alt="Tickets"
                src="tickets.png"
                loading="lazy"
              />
              <div class="absolute w-[200px] sm:w-[400px] h-[100px] top-[35px] sm:top-[45px] left-[120px] sm:left-[180px] h-brand font-extrabold text-[#592d10] text-3xl sm:text-6xl tracking-[0]">
                BUY TICKETS
              </div>
            </div>
          </a>
        </section>

        <!-- Action cards -->
        <section class="flex justify-center mt-6 sm:-mt-8">
          <div class="relative w-[832px] h-[562px] hidden sm:block">
            {actionCards.map((card, index) => {
              const pos =
                index === 0
                  ? 'top-0 left-0'
                  : index === 1
                    ? 'top-0 left-[435px]'
                    : index === 2
                      ? 'top-[340px] left-0'
                      : 'top-[340px] left-[435px]';
              return (
                <a
                  key={card.title}
                  href={card.fallbackHref}
                  data-modal-open={card.modal}
                  class={`absolute w-[397px] ${pos} cursor-pointer overflow-hidden rounded-[26px] transition-all duration-300 transform hover:scale-105`}
                  style={{ height: index <= 1 ? '328px' : '231px' }}
                >
                  <div class="relative h-full w-full">
                    <div
                      class="absolute left-0 w-full overflow-hidden rounded-[26px] border-[3px] border-solid border-black transition-colors duration-300"
                      style={{
                        backgroundColor: card.bg,
                        height: '212px',
                        top: index <= 1 ? '114px' : '18px',
                      }}
                    >
                      <div class="absolute w-full h-[66px] bottom-0 left-0 bg-[#f7f0d0] rounded-[0px_0px_23px_23px] z-10" />
                      <div class="absolute bottom-0 w-full h-[66px] flex items-center justify-center text-center h-brand font-extrabold text-black text-[42px] tracking-[0] whitespace-nowrap z-20">
                        {card.title}
                      </div>
                    </div>

                    <img
                      class="absolute object-contain"
                      alt={card.title}
                      src={card.img}
                      loading="lazy"
                      style={{
                        width:
                          index === 2 || index === 3
                            ? '186px'
                            : card.title === 'BECOME A SPEAKER'
                              ? '235px'
                              : '286px',
                        height:
                          index === 2 || index === 3
                            ? '186px'
                            : card.title === 'BECOME A SPEAKER'
                              ? '235px'
                              : '286px',
                        left: index === 0 ? '53px' : index === 1 ? '55px' : index === 2 ? '105px' : '110px',
                        top: card.title === 'BECOME A SPEAKER' ? '25px' : '0px',
                        zIndex: card.title === 'BRING TO YOUR CITY' ? 11 : 10,
                      }}
                    />
                  </div>
                </a>
              );
            })}
          </div>

          <!-- Mobile action cards -->
          <div class="w-full px-4 grid grid-cols-1 gap-6 sm:hidden">
            {actionCards.map((card) => (
              <a
                key={card.title}
                href={card.fallbackHref}
                data-modal-open={card.modal}
                class="relative w-full h-[300px] cursor-pointer transition-all duration-300 transform hover:scale-105"
              >
                <div
                  class="relative w-full h-full overflow-hidden rounded-[26px] border-[3px] border-solid border-black"
                  style={{ backgroundColor: card.bg }}
                >
                  <img
                    class="absolute left-1/2 -translate-x-1/2 object-contain"
                    alt={card.title}
                    src={card.img}
                    loading="lazy"
                    style={{ width: `${card.mobile.w}px`, height: `${card.mobile.h}px`, top: `${card.mobile.top}px` }}
                  />
                  <div class="absolute w-[calc(100%-6px)] h-[66px] bottom-[3px] left-[3px] bg-[#f7f0d0] rounded-[0px_0px_23px_23px] z-10" />
                  <div class="absolute bottom-[3px] left-[3px] w-[calc(100%-6px)] h-[66px] flex items-center justify-center text-center h-brand font-extrabold text-black text-[31px] tracking-[0] whitespace-nowrap z-20">
                    {card.title}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>

        <!-- MC Denver -->
        <section class="flex justify-center mt-8 sm:mt-12 px-4 sm:px-0">
          <a
            href="mc-denver/"
            data-modal-open="modal-mc"
            class="relative w-full h-[300px] sm:w-[397px] sm:h-[222px] bg-[#3b2f2f] hover:bg-[#2a2222] rounded-[26px] border-[3px] border-solid border-black cursor-pointer transform transition-all duration-300 hover:scale-105 overflow-hidden"
          >
            <div class="relative w-full h-full">
              <img
                class="absolute w-[300px] h-[300px] sm:w-[200px] sm:h-[200px] top-[-30px] sm:top-[-20px] left-1/2 -translate-x-1/2 object-contain z-10"
                alt="MC Denver"
                src="mc-denver.png"
                loading="lazy"
              />
              <div class="absolute w-full h-[66px] bottom-0 left-0 bg-[#f7f0d0] rounded-[0px_0px_23px_23px] z-10" />
              <div class="absolute bottom-0 w-full h-[66px] flex items-center justify-center text-center h-brand font-extrabold text-black text-[31px] sm:text-[42px] tracking-[0] whitespace-nowrap z-20">
                MC DENVER
              </div>
            </div>
          </a>
        </section>

        <!-- FAQ -->
        <section class="flex flex-col items-center justify-center p-1.5 mt-13">
          <div class="flex justify-center mb-8">
            <img
              class="w-[150px] h-[150px] sm:w-[230px] sm:h-[230px] object-cover"
              alt="FAQ"
              src="faq-1.png"
              loading="lazy"
            />
          </div>

          <div class="w-full max-w-[800px] px-4 sm:px-0">
            {faqs.map((faq) => (
              <details class="border-b border-black/20 py-3">
                <summary class="cursor-pointer select-none text-left text-lg font-semibold">
                  {faq.q}
                </summary>
                <div class="mt-2 text-base text-slate-900/90">{faq.a}</div>
              </details>
            ))}
          </div>
        </section>

        <section class="mt-12 pb-10 flex justify-center">
          <a class="text-sm underline" href="privacy/">Privacy</a>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

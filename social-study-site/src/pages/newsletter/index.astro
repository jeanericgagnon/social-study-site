---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import '../../styles/global.css';

const title = 'Newsletter Archive | The Social Study';
const description = 'Newsletter archive for The Social Study: announcements, event drops, and recaps.';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main class="mx-auto max-w-4xl px-4 pb-20">
    <h1 class="h-brand mt-6 text-5xl">Newsletter archive</h1>
    <p class="mt-4 text-lg text-slate-700">All updates in one place. (We’ll start syncing every Mailchimp send here.)</p>

    <div class="mt-10 rounded-2xl border border-slate-200 bg-white/60 p-5">
      <div class="h-brand text-xl">Coming soon</div>
      <p class="mt-2 text-slate-700">For now, subscribe by city to get ticket drops.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="rounded-full border border-slate-300 px-5 py-3 hover:bg-white" href="../san-diego/#signup">San Diego</a>
        <a class="rounded-full border border-slate-300 px-5 py-3 hover:bg-white" href="../orange-county/#signup">Orange County</a>
        <a class="rounded-full border border-slate-300 px-5 py-3 hover:bg-white" href="../denver/#signup">Denver</a>
      </div>
    </div>

    <footer class="mt-16 border-t border-slate-200 pt-8 text-sm text-slate-600">
      <a class="underline" href="../privacy/">Privacy</a>
    </footer>
  </main>
</BaseLayout>

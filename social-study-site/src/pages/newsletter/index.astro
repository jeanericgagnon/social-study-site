---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import newsletters from '../../data/newsletters.json';
import '../../styles/global.css';

const title = 'Newsletter | The Social Study';
const description = 'Interview-style newsletters: thoughtful Q&A with our speakers—ideas worth bringing to the bar and into real life.';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main class="mx-auto max-w-5xl px-4 pb-20">
    <header class="mt-6 rounded-[26px] border-[3px] border-black bg-[var(--cream)] p-6 md:p-10">
      <h1 class="h-brand text-5xl">Newsletter</h1>
      <p class="mt-4 text-lg text-slate-800">
        We interview our speakers the way you actually want to talk to them—
        the ideas behind the talk, the parts they didn’t have time to include,
        and the questions you’d ask over a drink.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a class="rounded-full border-[3px] border-black bg-white px-6 py-3 font-semibold hover:bg-slate-50" href="#archive">
          Read the archive
        </a>
        <a class="rounded-full border-[3px] border-black bg-[var(--gold)] px-6 py-3 font-semibold text-[#592d10] hover:opacity-90" href="#subscribe">
          Subscribe
        </a>
      </div>

      <p class="mt-4 text-sm text-slate-700">
        One newsletter. All cities. No spam.
      </p>
    </header>

    <section class="mt-12" id="archive">
      <div class="h-brand text-2xl">Archive</div>
      <p class="mt-2 text-slate-700">
        Speaker Q&A articles. Newest first.
      </p>

      {newsletters.items?.length ? (
        <div class="mt-6 grid gap-4">
          {newsletters.items.map((item) => (
            <a
              class="block rounded-[26px] border-[3px] border-black bg-white p-5 hover:bg-slate-50"
              href={`./${item.slug}/`}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div class="h-brand text-2xl">{item.title}</div>
                <div class="text-sm text-slate-600">{item.date}</div>
              </div>
              <p class="mt-2 text-slate-700">{item.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <div class="rounded-[26px] border-[3px] border-black bg-white p-5">
            <div class="h-brand text-xl">What to expect</div>
            <ul class="mt-3 list-disc pl-5 text-slate-700">
              <li>Short Q&A with the speaker</li>
              <li>Favorite references + rabbit holes</li>
              <li>One idea to bring into real life</li>
            </ul>
          </div>
          <div class="rounded-[26px] border-[3px] border-black bg-white p-5">
            <div class="h-brand text-xl">No issues synced yet</div>
            <p class="mt-2 text-slate-700">
              Run the Mailchimp sync script and the archive will populate automatically.
            </p>
            <p class="mt-3 text-sm text-slate-600">
              (We’ll publish each newsletter as a permanent article page with a shareable link.)
            </p>
          </div>
        </div>
      )}
    </section>

    <section class="mt-12" id="subscribe">
      <div class="h-brand text-2xl">Subscribe</div>
      <p class="mt-2 text-slate-700">
        Newsletter is the same for everyone. We still ask you to pick a city so we know where you want events.
      </p>

      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a class="rounded-full border-[3px] border-black bg-[var(--teal)] px-6 py-3 font-semibold text-white hover:opacity-90" href="../san-diego/#signup">San Diego</a>
        <a class="rounded-full border-[3px] border-black bg-[var(--coral)] px-6 py-3 font-semibold text-white hover:opacity-90" href="../orange-county/#signup">Orange County</a>
        <a class="rounded-full border-[3px] border-black bg-[var(--espresso)] px-6 py-3 font-semibold text-white hover:opacity-90" href="../denver/#signup">Denver</a>
      </div>

      <div class="mt-6 flex justify-center">
        <a class="text-sm underline" href="https://eventship.com/host/the-social-study" rel="noopener">Get tickets</a>
      </div>
    </section>

    <footer class="mt-16 border-t border-slate-200 pt-8 text-sm text-slate-600">
      <a class="underline" href="../privacy/">Privacy</a>
    </footer>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MailchimpSignup from '../components/MailchimpSignup.astro';
import '../styles/global.css';

const title = 'Orange County | The Social Study — Lectures in Bars and Breweries';
const description = 'Educational talks over drinks in Orange County. 60-minute lectures by professors, experts, and storytellers — then stay to meet people.';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main class="mx-auto max-w-4xl px-4 pb-20">
    <h1 class="h-brand mt-6 text-5xl">Orange County</h1>
    <p class="mt-4 text-lg text-slate-700">
      Thought-provoking talks in bars and breweries — built for curious people who want a smarter night out.
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a class="rounded-full bg-slate-900 px-5 py-3 text-white hover:bg-slate-800" href="https://eventship.com/host/the-social-study" rel="noopener">Get tickets</a>
      <a class="rounded-full border border-slate-300 px-5 py-3 hover:bg-white" href="../#cities">Other cities</a>
    </div>

    <section class="mt-10 grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white/60 p-5">
        <div class="h-brand text-xl">Where</div>
        <p class="mt-2 text-slate-700">Rotating venues across Orange County (details in your ticket confirmation).</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white/60 p-5">
        <div class="h-brand text-xl">Who</div>
        <p class="mt-2 text-slate-700">College-educated 26–40 crowd. Friendly, curious, and social.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white/60 p-5">
        <div class="h-brand text-xl">After</div>
        <p class="mt-2 text-slate-700">The talk is the spark — the real magic is meeting people afterward.</p>
      </div>
    </section>

    <div class="mt-12">
      <MailchimpSignup
        title="Get Orange County ticket drops"
        subtitle="Be first to know when tickets go live in Orange County."
        f_id="001ae6e3f0"
        tags="1853487"
      />
    </div>

    <footer class="mt-16 border-t border-slate-200 pt-8 text-sm text-slate-600">
      <a class="underline" href="../privacy/">Privacy</a>
    </footer>
  </main>
</BaseLayout>
